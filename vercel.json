{
  "rewrites": [
    { "source": "/jugar/:slug", "destination": "/jugar.html" },
    { "source": "/jugar/:slug/", "destination": "/jugar.html" },
    { "source": "/jugar", "destination": "/jugar.html" },
    { "source": "/estudio", "destination": "/estudio.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
