VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identidad de este deploy. El catálogo la publica como proveedor y
# como motor, y el estudio la muestra en el login y la barra.
# Cada proveedor pone la suya. Si falta, queda gameswin777.
VITE_PROVEEDOR_NOMBRE=gameswin777

# Panel del casino de este deploy (saldo, apostar, premiar).
# WIN777_PROVEEDOR_SECRETO y WIN777_API_BASE siguen valiendo si el
# deploy actual ya los tiene cargados.
PROVEEDOR_SECRETO=
PROVEEDOR_API_BASE=

# Dos repos GitHub, dos proyectos Vercel, mismo código.
# Este archivo es la plantilla. La cara de producción va en
# .env.production (commiteado): jugar en el repo de jugadores,
# estudio en el repo del ensamblador.
#
# Local: no pongas VITE_CARA. Conviven /estudio y /jugar.
# VITE_DOMINIO_JUGAR es solo el respaldo si el catálogo no recibe un
# host público. En producción la launch_url sale del dominio del pedido.
VITE_CARA=
VITE_DOMINIO_JUGAR=games777bet-user.vercel.app
VITE_DOMINIO_ESTUDIO=
